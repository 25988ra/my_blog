---
import SiteLayout from '../layouts/SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts, postUrl } from '../lib/posts';

const posts = await getPublishedPosts();
const years = Map.groupBy(posts, (post) => post.data.pubDate.getUTCFullYear());
---
<SiteLayout title="归档" description="按年份查看已发布文章">
  <div class="page-heading"><h1>文章归档</h1><p>按发布时间浏览全部文章。</p></div>
  {Array.from(years, ([year, entries]) => (
    <section class="archive-year">
      <h2>{year}</h2>
      <ul>{entries.map((post) => <li><FormattedDate date={post.data.pubDate} /><a href={postUrl(post)}>{post.data.title}</a></li>)}</ul>
    </section>
  ))}
</SiteLayout>
