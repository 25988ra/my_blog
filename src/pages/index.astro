---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import PostCard from '../components/PostCard.astro';
import { researchTopics } from '../consts';
import { filterUrl, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const featured = posts.filter(({ data }) => data.featured).slice(0, 3);
const latest = posts.slice(0, 3);
---
<SiteLayout wide>
  <HomeHero />
  <div class="shell home-content">
    <section aria-labelledby="research-title">
      <h2 id="research-title">研究方向</h2>
      <div class="card-grid research-grid">
        {researchTopics.map((topic) => (
          <a class="topic-card" href={filterUrl('tag', topic.tag)}>
            <h3>{topic.title}</h3>
            <p>{topic.note}</p>
          </a>
        ))}
      </div>
    </section>
    {featured.length > 0 && <section aria-labelledby="featured-title">
      <h2 id="featured-title">精选文章</h2>
      <div class="card-grid">{featured.map((post) => <PostCard {post} />)}</div>
    </section>}
    <section aria-labelledby="latest-title">
      <div class="section-head">
        <h2 id="latest-title">最新文章</h2>
        <a href="/blog/">查看全部</a>
      </div>
      {latest.length
        ? <div class="card-grid">{latest.map((post) => <PostCard {post} />)}</div>
        : <p>暂无已发布的文章。</p>}
    </section>
  </div>
</SiteLayout>
