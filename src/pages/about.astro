---
import SiteLayout from '../layouts/SiteLayout.astro';
import { GITHUB_PROFILE, GITHUB_REPO, profile, researchTopics } from '../consts';
---
<SiteLayout title="关于" description="Richard 的个人介绍与研究方向">
  <div class="page-heading">
    {profile.avatar && <img class="about-avatar" src={profile.avatar} alt="" width="80" height="80" />}
    <h1>关于 Richard</h1>
    <p>{profile.intro}</p>
  </div>
  <section class="prose">
    <h2>研究方向</h2>
    <ul>{researchTopics.map((topic) => <li><strong>{topic.title}</strong>。{topic.note}</li>)}</ul>
    <h2>联系</h2>
    <p>欢迎通过 <a href={GITHUB_PROFILE}>GitHub</a> 交流，也可以在<a href={GITHUB_REPO}>本站源码仓库</a>反馈文章中的问题。</p>
  </section>
</SiteLayout>
