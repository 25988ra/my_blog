---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`页面未找到 - ${SITE_TITLE}`} description="这个页面可能已经移动，或链接地址有误。" />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main>
			<h1>页面未找到</h1>
			<p>这个页面可能已经移动，或链接地址有误。</p>
			<p><a href="/">返回首页</a> · <a href="/blog/">浏览文章</a></p>
		</main>
		<Footer />
	</body>
</html>
