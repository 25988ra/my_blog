---
import { GITHUB_PROFILE, profile } from '../consts';
---
<section class="home-hero" aria-labelledby="home-title">
  {profile.banner && <img class="banner-image" src={profile.banner} alt="" fetchpriority="high" />}
  <div class="stage" aria-hidden="true">
    <div class="stage-frame"></div>
    <div class="stage-arch"></div>
    <div class="stage-orbit"></div>
    <div class="stage-light"></div>
    <div class="stage-ripples"></div>
  </div>
  <div class="shell hero-inner">
    <div class="hero-copy">
      <h1 id="home-title">科研笔记与<span>数值模拟</span></h1>
      <p>{profile.intro}</p>
      <div class="actions">
        <a class="button hero-primary" href="/blog/">浏览文章</a>
        <a class="button hero-secondary" href="/latex-lab/">LaTeX Lab</a>
      </div>
      <a class="hero-profile" href={GITHUB_PROFILE}>
        {profile.avatar
          ? <img src={profile.avatar} alt="" width="34" height="34" />
          : <span aria-hidden="true">R</span>}
        {profile.name} · GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: radial-gradient(ellipse at 74% 35%, #245c91 0, transparent 47%),
      linear-gradient(125deg, var(--stage-start) 12%, var(--stage-end) 100%);
    color: #f9fcff;
    border-bottom: 1px solid var(--gold);
  }
  .banner-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right center; opacity: .65; z-index: -2; }
  .home-hero:has(.banner-image)::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #0b203c 10%, #0b203ce6 38%, #0b203c18); z-index: -1; }
  .hero-inner { display: grid; min-height: clamp(26rem, 51vw, 36rem); align-items: center; padding-block: clamp(3.3rem, 9vw, 7rem); }
  .hero-copy { max-width: 34rem; }
  h1 { margin: 0; font-size: clamp(2.65rem, 6.3vw, 5.1rem); line-height: 1.16; color: #fff; letter-spacing: -.055em; }
  h1 span { display: block; color: #b5d7fa; }
  p { max-width: 26rem; color: #d2e4f9; margin-block: 1.5rem; font-size: 1.125rem; }
  .hero-primary { background: #f4f8fe; color: #17365a; border-color: #f4f8fe; }
  .hero-secondary { background: #162f51; color: #f4f8fe; border-color: #7395ba; }
  .hero-primary:hover { background: #d5e7fb; color: #17365a; }
  .hero-secondary:hover { background: #24476e; color: #fff; }
  .hero-profile { display: inline-flex; align-items: center; gap: .6rem; margin-top: 1.5rem; color: #d9e9fc; font-size: .9375rem; }
  .hero-profile img, .hero-profile span { width: 2.125rem; height: 2.125rem; border-radius: 50%; object-fit: cover; }
  .hero-profile span { display: grid; place-items: center; border: 1px solid #a38662; background: #203d62; font-family: Georgia, serif; color: #f6dfa8; }
  .stage { position: absolute; z-index: -1; inset: 0 0 0 45%; overflow: hidden; opacity: .94; pointer-events: none; }
  .home-hero:has(.banner-image) .stage { opacity: .35; }
  .stage-frame { position: absolute; inset: 11% 11% 0 6%; border: 1px solid #c9af7966; border-bottom: 0; border-radius: 50% 50% 0 0 / 60% 60% 0 0; box-shadow: 0 0 0 10px #eac8840b, 0 0 0 21px #c9af7925; }
  .stage-arch { position: absolute; inset: 23% 19% 0 14%; border: 1px solid #a8d6fb63; border-bottom: 0; border-radius: 50% 50% 0 0 / 60% 60% 0 0; background: linear-gradient(0deg, transparent 23%, #a5cfff0f); }
  .stage-orbit { position: absolute; width: 78%; height: 35%; top: 39%; left: 2%; transform: rotate(-17deg); border: 1px solid #d4ecff69; border-radius: 50%; box-shadow: 0 0 0 15px #a5ccf618, 0 0 0 31px #a5ccf60e; }
  .stage-light { position: absolute; top: 33%; left: 32%; width: 24%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 37%, #f0f6ff, #9ac9f7 28%, #5189bd 60%, #2a527e 74%); box-shadow: 0 0 4.5rem #7ac6ff9c; opacity: .85; }
  .stage-ripples { position: absolute; inset: 70% -9% -22% -12%; transform: rotate(-9deg); background: repeating-radial-gradient(ellipse at 46% 0, transparent 0 1.15rem, #afdaff36 1.18rem 1.22rem, transparent 1.25rem 1.7rem); mask-image: linear-gradient(#0000, #000 32%, #0000 85%); }
  @media (max-width: 720px) {
    .stage { inset-inline-start: 32%; opacity: .52; }
    .hero-copy { max-width: 27rem; }
  }
</style>
